async function initDocNum() {
  document.getElementById('docNumber').textContent = 'טוען...';
  try {
    const res = await sheetsGet('getLastDocNum');
    if (res && res.lastDocNum !== undefined) {
      const nextNum = parseInt(res.lastDocNum) + 1;
      const formattedNum = 'S' + String(nextNum).padStart(5, '0');
      document.getElementById('docNumber').textContent = 'מס׳ ' + formattedNum;
      document.getElementById('docNum').value = formattedNum;
    }
  } catch(e) {
    document.getElementById('docNumber').textContent = 'שגיאת שרת';
  }
}

